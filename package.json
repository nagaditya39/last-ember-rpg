{
  "name": "dm-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project Bridgeline - phone-first team decision-game prototype (pre-generated story, no live LLM)",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "lint:story": "tsx server/lint-story.ts",
    "sim": "tsx server/sim.ts",
    "test:feed": "tsx server/test-feed.ts",
    "typecheck": "tsc --noEmit",
    "loadtest": "tsx server/loadtest.ts",
    "demo:docs": "vite build --mode demo && node -e \"require('fs').copyFileSync('dist-demo/index.html','docs/index.html')\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
